# ── Supabase ────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in the real values from your Supabase project:
# https://supabase.com/dashboard/project/_/settings/api
#
# The app detects when these are missing and renders a friendly state instead
# of crashing, so it also works locally without them.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key